#!name=Dcard Link
#!desc=去除 Dcard 链接页面中的广告元素
#!category=For Own Use
#!author=Destellovo

[Script]
Dcard 链接页面去广告 = type=http-response, pattern=^https?:\/\/(?:www\.)?dcard\.tw\/(?:f|@|_api|service|topics|search|personal|posts)(?:[/?#].*)?$, requires-body=true, max-size=0, timeout=10, script-path=https://raw.githubusercontent.com/Destellovo/Surge/main/dcard_link.js

[MITM]
hostname = %APPEND% dcard.tw, www.dcard.tw
