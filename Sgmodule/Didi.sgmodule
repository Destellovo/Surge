#!name=滴滴去广告
#!desc=移除开屏广告、弹窗广告、横幅推广，精简我的页面。
#!author=Destello
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DiDi.png
#!openUrl=https://apps.apple.com/app/id554499054
#!category=For Own Use
#!homepage=https://hub.kelee.one
#!date=2026-09-03 16:19:24

[Rule]
DOMAIN,gwp.xiaojukeji.com,REJECT,extended-matching,pre-matching
DOMAIN,gwpgz.diditaxi.com.cn,REJECT,extended-matching,pre-matching
DOMAIN,adtrack.xiaojukeji.com,REJECT,extended-matching,pre-matching
# 来自 HTTPDNS 拦截器与广告平台拦截器的滴滴相关补充
DOMAIN,hd.xiaojukeji.com,REJECT,extended-matching,pre-matching
DOMAIN,pgdt.gtimg.cn,REJECT,extended-matching,pre-matching
# 阻止代驾通过 TCP 长连接重新下发推广配置
AND,((IP-ASN,45090,no-resolve),(DEST-PORT,25641),(PROTOCOL,TCP)),REJECT
AND,((IP-ASN,55990,no-resolve),(DEST-PORT,25641),(PROTOCOL,TCP)),REJECT
AND,((IP-ASN,63646,no-resolve),(DEST-PORT,25641),(PROTOCOL,TCP)),REJECT

[Map Local]
^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=prado\.cms\.delivery\.batch data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=prado\.cms\.AggregateDeliveryRemoteService\.aggregateDelivery data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.c\.p\.queryLevelAndRightsStatus data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.p\.popup data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/pSFCHomePage\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/htwkop-st\.xiaojukeji\.com\/gateway\?api=cms\.htw\.delivery\.batch data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/freight\.xiaojukeji\.com\/gateway\?api=freight\.d\.core\.multiDisplayV\d data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/lion\.didialift\.com\/broker\/\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/ct\.xiaojukeji\.com\/agent\/v3\/feeds\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/conf\.diditaxi\.com\.cn\/dynamic\/conf data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/recommend\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq ^https:\/\/as\.xiaojukeji\.com\/ep\/as\/toggles\? '. as $original | try (if (.data? | type) == "array" then .data |= (map(select(.name? != "isUseNetConnectivity")) | map(if ((.name? // "") | IN("daijia_journey_new_tcp_switch","daijia_tcp_init","daijia_tcp_msg_encrypt","daijia_tcp_site_info","daijia_tcp_site_report")) then .allow = false else . end)) else . end) catch $original'
http-response-jq ^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/slow\? '. as $original | try (if ((type) == "object" and (.data? | type) == "object" and (.data.order_cards? | type) == "object") then delpaths([["data","order_cards","new_loss_banner_card"],["data","order_cards","call_car_card_80"]]) else . end) catch $original'
http-response-jq ^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/core\? '. as $original | try (if (.data.order_cards.nav_list_card.data? | type) == "array" then .data.order_cards.nav_list_card.data |= map(select((.nav_id? // "") | IN("dache_anycar","carmate","driverservice","zhandianbashi","yuancheng","pincheche","bike","special_ride","nav_more_v3"))) else . end | if (.data.disorder_cards.top_nav_list.data.top_nav_info? | type) == "array" then .data.disorder_cards.top_nav_list.data.top_nav_info |= map(select((.nav_id? // "") | IN("chu_xing","freight_cargo"))) else . end | if (.data.disorder_cards.bottom_nav_list.data? | type) == "array" then .data.disorder_cards.bottom_nav_list.data |= map(select((.id? // "") | IN("home_page","user_center"))) else . end) catch $original'
http-response-jq ^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/fast\? '. as $original | try (delpaths([["data","disorder_cards","communicate_card"],["data","disorder_cards","not_login_bottom_bar"],["data","disorder_cards","riding_code_card"],["data","disorder_cards","car_icon","data","icon_info_new_agreement"],["data","disorder_cards","guess_card"],["data","disorder_cards","scene_list_card"],["data","order_cards","car_owner_widget_card"],["data","order_cards","marketing_card"],["data","order_cards","super_banner_card"]])) catch $original'
http-response-jq ^https:\/\/common\.diditaxi\.com\.cn\/common\/v\d\/usercenter\/layout$ '. as $original | try (if (.data.instances? | type) == "object" then .data.instances |= with_entries(select(.key | IN("center_base_info_card","center_tool_card","center_wallet_finance_card","center_order_related_card"))) else . end | if (.data.instances.center_wallet_finance_card.data.view_info? | type) == "array" then .data.instances.center_wallet_finance_card.data.view_info |= map(select((.title? // "") | IN("优惠卡券"))) else . end) catch $original'
http-response-jq ^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/dache_homepage_layout\? '. as $original | try (if (.data.instances? | type) == "object" then .data.instances |= with_entries(select(.key | test("feed_back_|dache_main_member|order_container_|dache_main_core_icon|dache_main_card_"))) else . end) catch $original'
http-response-jq ^https:\/\/api\.udache\.com\/intercity\/ticket\/api\/v\d\/core\/getFullPageInfoLayout\? '. as $original | try (if (.data.disorder_components? | type) == "array" then .data.disorder_components |= map(select((.name? // "") | IN("history_order_card","inprogress_order_card","station_calendar","main_card_v2","user_history_order"))) else . end) catch $original'
http-response-jq ^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.apolloConfig '. as $original | try (if (.data? | type) == "array" then .data |= map(select((.name? // "") | IN("daijia-memberInfo-config","daijia-transfer-share-config") | not)) else . end) catch $original'
http-response-jq ^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.apolloToggle '. as $original | try (if (.data? | type) == "array" then .data |= map(select((.name? // "") | IN("daijia_app_estimate_pre_req_switch","daijia_agent_car_picture_check","daijia_bluetooth_wifi_degrade_switch","daijia_weixin_publish_login","daijia_estimate_recommend_degrade_switch","daijia_yugu_policy_switch","daijia_home_location_guide_switch","daijia_estimate_switch"))) else . end) catch $original'
http-response-jq ^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/bronze\/pinchengle_homepage_layout$ '. as $original | try (if (.data.instances? | type) == "object" then .data.instances |= with_entries(select(.key | IN("dacheanycar-certificates-1","main-card-1","map-1","nav-1","tool-container-1"))) else . end) catch $original'
http-response-jq ^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/SFCHomeTab\? '. as $original | try (if (.data.tab_list? | type) == "array" then .data.tab_list |= map(select((.tab_id? // "") | IN("passenger","driver"))) else . end) catch $original'
http-response-jq ^https:\/\/htwkop\.xiaojukeji\.com(:443)?\/gateway\?api=hm\.fa\.querySellCardSummary '. as $original | try (.data = {}) catch $original'
http-response-jq ^https:\/\/htwkop\.xiaojukeji\.com(:443)?\/gateway\?api=hm\.fa\.queryWelfareCenter '. as $original | try (.data = {}) catch $original'
http-response-jq ^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/startinfo\?api_version '. as $original | try (del(.rec_destination)) catch $original'
http-response-jq ^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/poiinfo\?product_id '. as $original | try (del(.rec_destination)) catch $original'
http-response-jq ^https:\/\/common\.diditaxi\.com\.cn\/user_common\/itineraryList\? '. as $original | try (if (.data.tab_nav? | type) == "array" then del(.data.tab_nav[]?.tab_param) else . end) catch $original'

[MITM]
hostname = %APPEND% as.xiaojukeji.com, conf.diditaxi.com.cn, common.diditaxi.com.cn, res.xiaojukeji.com, api.udache.com, daijia.kuaidadi.com, htwkop-st.xiaojukeji.com, htwkop.xiaojukeji.com, freight.xiaojukeji.com, poi.map.xiaojukeji.com, lion.didialift.com, ct.xiaojukeji.com
