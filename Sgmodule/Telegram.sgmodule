#!name=Telegram 重定向
#!desc=适用于安装了多个不同Telegram客户端的用户，用于在指定客户端中打开公开或私有群组及频道的Telegram短链。
#!category=For Own Use

[Argument]
app = select, tg, sg, turrit, ime, ng, lingo, tag=客户端, desc=指定跳转的客户端

[URL Rewrite]
^https:\/\/t\.me\/([A-Za-z][A-Za-z0-9_]{3,30}[A-Za-z0-9])\/?$ ${app}://resolve?domain=$1 307
^https:\/\/t\.me\/\+([A-Za-z0-9_-]+)\/?$ ${app}://join?invite=$1 307

[MITM]
hostname = %APPEND% t.me
